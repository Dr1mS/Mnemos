bench/data/beam/
# Bases Mnemos ingérées par les benchs, gardées pour être relues (--base)
bench/data/bases/

# Caches de reprise des benchs (résultats au fil de l'eau) : locaux, jamais commités
bench/results/**/*.cache.jsonl
