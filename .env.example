# Ollama
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=bge-m3
SALIENCE_MODEL=qwen2.5:3b
EXTRACTION_MODEL=qwen2.5:3b
# Modèles AML (cf. AML_DEPLOYMENT_WINDOWS.md) : qwen2.5:3b pour saillance et extraction
LLM_THINK=false

# Backend d'embeddings : "ollama" (défaut) ou "llamacpp" (llama-server en direct).
# Ollama force -np 1 sur les modèles d'embedding et ajoute ~146 ms par appel via
# son saut parent -> runner ; sous concurrence il répond HTTP 400 pendant la
# montée d'un runner. En direct : 16 slots, 51 msg/s en Add et 48 req/s en
# Search à concurrence 16, zéro erreur, vecteurs identiques (cosinus 0,999999650).
# Nécessaire pour AML, qui impose Add et Search à une concurrence >= 16.
# Démarrer le serveur : .\scripts\register_llamacpp_task.ps1
EMBED_BACKEND=ollama
LLAMACPP_HOST=http://127.0.0.1:8899

# Storage
DATA_DIR=./data
EPISODIC_DB=./data/episodic.db
SEMANTIC_DB=./data/semantic.db
PROCEDURAL_DIR=./data/procedural

# Server
API_HOST=127.0.0.1
API_PORT=8765
LOG_LEVEL=INFO

# Memory dynamics
SALIENCE_THRESHOLD_CONSOLIDATE=0.6
SALIENCE_THRESHOLD_DECAY_FAST=0.2
DECAY_RATE_DAILY=0.05
# Attente avant consolidation (0.0 pour benchmark AML en direct, 1.0 en usage standard)
CONSOLIDATION_DELAY_HOURS=0.0
EPISODIC_RETENTION_DAYS=90

# Consolidation worker
CONSOLIDATION_AUTO=true
CONSOLIDATION_INTERVAL_SECONDS=5.0
CONSOLIDATION_INTERVAL_MINUTES=60
CONSOLIDATION_BATCH_SIZE=20

# Concurrency (ModelManager)
LLM_TIER_SMALL_CONCURRENCY=4
LLM_TIER_MEDIUM_CONCURRENCY=1
