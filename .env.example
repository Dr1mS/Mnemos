# Ollama
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=bge-m3
SALIENCE_MODEL=qwen2.5:3b
EXTRACTION_MODEL=qwen2.5:3b
# Modèles AML (cf. AML_DEPLOYMENT_WINDOWS.md) : qwen2.5:3b pour saillance et extraction
LLM_THINK=false

# Storage
DATA_DIR=./data
EPISODIC_DB=./data/episodic.db
SEMANTIC_DB=./data/semantic.db
PROCEDURAL_DIR=./data/procedural

# Server
API_HOST=127.0.0.1
API_PORT=8765
LOG_LEVEL=INFO

# Memory dynamics
SALIENCE_THRESHOLD_CONSOLIDATE=0.6
SALIENCE_THRESHOLD_DECAY_FAST=0.2
DECAY_RATE_DAILY=0.05
# Attente avant consolidation (0.0 pour benchmark AML en direct, 1.0 en usage standard)
CONSOLIDATION_DELAY_HOURS=0.0
EPISODIC_RETENTION_DAYS=90

# Consolidation worker
CONSOLIDATION_AUTO=true
CONSOLIDATION_INTERVAL_SECONDS=5.0
CONSOLIDATION_INTERVAL_MINUTES=60
CONSOLIDATION_BATCH_SIZE=20

# Concurrency (ModelManager)
LLM_TIER_SMALL_CONCURRENCY=4
LLM_TIER_MEDIUM_CONCURRENCY=1
